# Veyra sample app configuration — copy this file to veyra.properties and fill in the
# values issued to you during Veyra onboarding. veyra.properties is git-ignored; never
# commit it: a client secret in a tracked file must be treated as compromised.

# Veyra Maven repository credentials (repo.veyra.co — issued by Veyra; used by
# settings.gradle to resolve the SDK artifacts)
veyra.repoUsername=your-repo-username
veyra.repoPassword=your-repo-password

# Identifiers assigned to your app at onboarding
veyra.paymentAppProviderId=your-payment-app-provider-id
veyra.tokenRequestorId=your-token-requestor-id

# ── The values for the provider both SDKs use ──────────────────────────────────
# There is no mode to set: the SDK works out how to reach Veyra from the provider the app passes.
# Which one the sample builds is chosen in code, in AppConnection.provider(). It ships with the
# deprecated client-secret provider so the sample runs with just the client id and secret from
# your onboarding pack — FOR TESTING ONLY. Each provider reads only its own values:
#   assertion provider      clientId + bankBackendBaseUrl (your backend serves POST /sdk-assertion)
#   proxy provider          bankBackendBaseUrl (your backend serves POST /veyra-relay/{method})
#   client-secret provider  DEPRECATED — clientId + clientSecret held in the app

# OAuth client issued by Veyra. clientId: the assertion and client-secret providers.
# clientSecret: the client-secret provider only.
veyra.clientId=your-client-id
veyra.clientSecret=your-client-secret

# Your bank backend (the assertion and proxy providers), e.g. https://bank-backend.example
veyra.bankBackendBaseUrl=

# PLACEHOLDER for your bank app's own logged-in session, sent to your bank backend as
# "Authorization: Bearer <token>"; blank means nobody is signed in. A real app uses its own
# login session here. This is not a Veyra credential.
veyra.bankSessionToken=sample-bank-session
