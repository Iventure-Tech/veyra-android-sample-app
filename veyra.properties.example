# Veyra sample app credentials — copy this file to veyra.properties and fill in the
# values issued to you during Veyra onboarding. veyra.properties is git-ignored; never
# commit real credentials.

# Veyra Maven repository credentials (repo.veyra.co — issued by Veyra; used by
# settings.gradle to resolve the SDK artifacts)
veyra.repoUsername=your-repo-username
veyra.repoPassword=your-repo-password

# OAuth client credentials (issued by Veyra)
veyra.clientId=your-client-id
veyra.clientSecret=your-client-secret

# Identifiers assigned to your app at onboarding
veyra.paymentAppProviderId=your-payment-app-provider-id
veyra.tokenRequestorId=your-token-requestor-id
