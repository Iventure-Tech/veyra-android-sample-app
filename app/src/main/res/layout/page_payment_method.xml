<?xml version="1.0" encoding="utf-8"?>
<!-- Payment-method choice after amount entry: Tap to pay (NFC) or Scan QR (MPM).
     Same visual language as page_merchant_type_selection. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@drawable/gradient_black_background">

    <ImageButton
        android:id="@+id/methodBackButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_arrow_back"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back"
        app:tint="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/methodHeaderText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/payment_method_title"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toBottomOf="@id/methodBackButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/methodAmountDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="₦ 0.00"
        android:textSize="44sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/methodHeaderText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toBottomOf="@id/methodAmountDisplay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tapToPayButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/payment_method_tap"
            android:textSize="18sp"
            android:padding="20dp"
            android:layout_marginBottom="16dp"
            app:icon="@drawable/ic_contactless"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/qrButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/payment_method_qr"
            android:textSize="18sp"
            android:padding="20dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:textColor="@android:color/white"
            app:icon="@drawable/ic_qr_code"
            app:iconTint="@android:color/white"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
