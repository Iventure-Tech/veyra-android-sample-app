<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Header: app title + settings cog -->
    <LinearLayout
        android:id="@+id/headerRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="8dp"
        android:paddingTop="48dp"
        android:paddingBottom="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/appTitleTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@android:color/white" />

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings"
            android:contentDescription="Settings"
            android:padding="10dp" />

    </LinearLayout>

    <!--
        Card area: fixed-height container so the scroll view always anchors
        below it regardless of whether cards or the empty-state are showing.
        Both children occupy the same space; only one is visible at a time.
    -->
    <FrameLayout
        android:id="@+id/cardArea"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerRow">

        <!-- Empty state -->
        <TextView
            android:id="@+id/noCardsText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="No cards yet.\nTap + to add your first card."
            android:textColor="#888888"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.4"
            android:visibility="gone" />

        <!-- Cards ViewPager -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/cardsViewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:overScrollMode="never" />

    </FrameLayout>

    <!-- Activity section: scrollable, always anchored below the card area -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/activityScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardArea"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/activitySection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="80dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/recentActivityTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recent_activity"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:paddingStart="4dp" />

            <LinearLayout
                android:id="@+id/activityTransactionsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/activityNoTransactionsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingStart="4dp"
                android:text="@string/no_recent_transactions"
                android:textSize="13sp"
                android:textColor="@android:color/darker_gray"
                android:visibility="gone" />

            <TextView
                android:id="@+id/viewMoreActivityButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:paddingStart="4dp"
                android:text="@string/view_more_activity"
                android:textSize="14sp"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Add card FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/addCardFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:src="@android:drawable/ic_input_add"
        android:contentDescription="Add card"
        app:tint="@android:color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Scan-to-pay (MPM QR rail): pay a merchant by scanning their QR -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/scanToPayFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="24dp"
        android:src="@drawable/ic_qr_code"
        android:contentDescription="@string/scan_to_pay"
        app:tint="@android:color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Show-QR-to-pay (CPM rail): present a payment QR the merchant scans -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/showQrFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="96dp"
        android:src="@drawable/ic_qr_code"
        android:contentDescription="@string/show_qr_to_pay"
        app:tint="@android:color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Transaction success checkmark overlay — centred on the card area -->
    <ImageView
        android:id="@+id/transactionSuccessCheckmark"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_checkmark_circle"
        android:contentDescription="Transaction successful"
        android:visibility="gone"
        android:alpha="0"
        android:elevation="16dp"
        app:layout_constraintStart_toStartOf="@id/cardArea"
        app:layout_constraintEnd_toEndOf="@id/cardArea"
        app:layout_constraintTop_toTopOf="@id/cardArea"
        app:layout_constraintBottom_toBottomOf="@id/cardArea" />

</androidx.constraintlayout.widget.ConstraintLayout>
