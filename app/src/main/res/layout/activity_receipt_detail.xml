<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F0F0"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingBottom="40dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- Receipt paper -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:elevation="4dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <!-- Merchant name -->
            <TextView
                android:id="@+id/receiptMerchantName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:textColor="@android:color/black"
                android:letterSpacing="0.05" />

            <!-- Merchant address -->
            <TextView
                android:id="@+id/receiptMerchantAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

            <!-- Merchant ID -->
            <TextView
                android:id="@+id/receiptMerchantId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="11sp"
                android:textColor="#888888"
                android:layout_marginTop="2dp"
                android:visibility="gone" />

            <!-- Divider -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="- - - - - - - - - - - - - - - - - - -"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp" />

            <!-- Date row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">
                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="DATE"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08" />
                <TextView
                    android:id="@+id/receiptDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textSize="12sp"
                    android:textColor="@android:color/black" />
            </LinearLayout>

            <!-- Time row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">
                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="TIME"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08" />
                <TextView
                    android:id="@+id/receiptTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textSize="12sp"
                    android:textColor="@android:color/black" />
            </LinearLayout>

            <!-- Transaction type row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">
                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="TYPE"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08" />
                <TextView
                    android:id="@+id/receiptType"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textSize="12sp"
                    android:textColor="@android:color/black" />
            </LinearLayout>

            <!-- Divider -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="- - - - - - - - - - - - - - - - - - -"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp" />

            <!-- Amount label -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="AMOUNT"
                android:textSize="11sp"
                android:textColor="#888888"
                android:textAllCaps="true"
                android:letterSpacing="0.12" />

            <!-- Amount value -->
            <TextView
                android:id="@+id/receiptAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp" />

            <!-- Currency -->
            <TextView
                android:id="@+id/receiptCurrency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="12sp"
                android:textColor="#888888"
                android:visibility="gone" />

            <!-- Divider -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="- - - - - - - - - - - - - - - - - - -"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp" />

            <!-- Status row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="STATUS"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08" />
                <TextView
                    android:id="@+id/receiptStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Card row -->
            <LinearLayout
                android:id="@+id/rowCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="CARD"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08" />
                <TextView
                    android:id="@+id/receiptCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textSize="12sp"
                    android:textColor="@android:color/black"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Reference row -->
            <LinearLayout
                android:id="@+id/rowRef"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="REF"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08" />
                <TextView
                    android:id="@+id/receiptRef"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textSize="12sp"
                    android:textColor="@android:color/black" />
            </LinearLayout>

            <!-- Transaction ID row -->
            <LinearLayout
                android:id="@+id/rowTxnId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="TXN ID"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08" />
                <TextView
                    android:id="@+id/receiptTxnId"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textSize="12sp"
                    android:textColor="@android:color/black" />
            </LinearLayout>

            <!-- CDCVM row -->
            <LinearLayout
                android:id="@+id/rowCdcvm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="VERIFIED"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08" />
                <TextView
                    android:id="@+id/receiptCdcvm"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textSize="12sp"
                    android:textColor="@android:color/black" />
            </LinearLayout>

            <!-- Divider -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="- - - - - - - - - - - - - - - - - - -"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp" />

            <!-- Footer -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="* * *  THANK YOU  * * *"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#444444"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Powered by Veyra"
                android:textSize="10sp"
                android:textColor="#AAAAAA"
                android:layout_marginTop="6dp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
