<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Onboarding identifiers (payment_app_provider_id, token_requestor_id) are injected
         from veyra.properties at build time, and the connection to Veyra (mode, client id/secret,
         bank backend) comes from the same file — see app/build.gradle and
         veyra.properties.example. Only non-secret configuration lives here. -->

    <string name="app_version">1.0.0</string>

    <!-- Provision Context (optional) - Allowed values for digitize request provision_context (lists).
         Country codes: ISO 3166-1 numeric, 4 digits e.g. 0566 (Nigeria), 0826 (UK). Not NGA/GBR. -->
    <string-array name="allowed_acquirer_ids">
        <item>ACQ001</item>
    </string-array>
    <string-array name="allowed_merchant_ids">
        <item>MERCHANT01</item>
    </string-array>

    <!-- supports_3ds for provision_channel_context -->
    <bool name="supports_3ds">false</bool>


    <!-- wallet_provider_tokenization_recommendation_standard_version for digitize request -->
    <string name="wallet_provider_tokenization_recommendation_standard_version">1.0</string>
</resources>
