<?xml version="1.0" encoding="utf-8"?>
<!-- Payment Banner for HCE Service -->
<!-- Required size: 260x96 dp (typically 780x288 px at xxxhdpi) -->
<!-- This banner is displayed in NFC payment settings when app is set as default payment app -->
<!-- Android silently disables payment HCE service if banner is missing or wrong size -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background with exact dimensions -->
    <item
        android:width="260dp"
        android:height="96dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="#E0E0E0" />
        </shape>
    </item>
    
    <!-- App Icon (centered, scaled appropriately) -->
    <item
        android:drawable="@mipmap/ic_launcher"
        android:gravity="center"
        android:width="64dp"
        android:height="64dp" />
</layer-list>

