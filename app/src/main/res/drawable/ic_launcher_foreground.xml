<?xml version="1.0" encoding="utf-8"?>
<!-- Veyra "V" monogram in crimson, sized within the adaptive-icon safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Bold V: two strokes meeting at a rounded point. -->
    <path
        android:pathData="M35,36 L54,74 L73,36"
        android:strokeColor="#FFC1272D"
        android:strokeWidth="11"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Small contactless-style dot above the V vertex for a subtle payment cue. -->
    <path
        android:pathData="M54,28 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0"
        android:fillColor="#FFC1272D" />
</vector>
