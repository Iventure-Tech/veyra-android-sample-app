<?xml version="1.0" encoding="utf-8"?>
<!-- EMV contactless symbol: dot + three right-facing arcs -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Centre dot -->
    <path
        android:pathData="M5,10.5m-2,0a2,2 0,1,1 4,0a2,2 0,1,1,-4,0"
        android:fillColor="#FFFFFF" />

    <!-- Small arc  (r=3.5, y: 7 → 14) -->
    <path
        android:pathData="M5,7 A3.5,3.5 0 0,1 5,14"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:fillColor="@android:color/transparent"
        android:strokeLineCap="round" />

    <!-- Medium arc (r=6,   y: 4.5 → 16.5) -->
    <path
        android:pathData="M5,4.5 A6,6 0 0,1 5,16.5"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:fillColor="@android:color/transparent"
        android:strokeLineCap="round" />

    <!-- Large arc  (r=8.5, y: 2 → 19) -->
    <path
        android:pathData="M5,2 A8.5,8.5 0 0,1 5,19"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:fillColor="@android:color/transparent"
        android:strokeLineCap="round" />

</vector>
